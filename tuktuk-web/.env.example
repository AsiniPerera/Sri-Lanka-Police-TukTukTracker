# ---- Asgardeo ----
# Console -> Applications -> TukTuk Tracker Console -> Protocol -> Client ID
VITE_ASGARDEO_CLIENT_ID=replace-me

# https://api.asgardeo.io/t/<your-organization-name>
VITE_ASGARDEO_BASE_URL=https://api.asgardeo.io/t/tuktuktracker

# ---- TukTukTracker API ----
VITE_API_BASE_URL=http://localhost:5000/api/v1

# NOTE: there is intentionally no client secret here. This is a public OAuth
# client (an SPA cannot keep a secret). Anything in a VITE_* var is compiled
# into the JS bundle and is readable by anyone who loads the page.

# ---- Optional: Google social login ----
# Name of the Google connection in Asgardeo (Console -> Connections).
# Leave empty/absent and the "Continue with Google" button is hidden.
VITE_ASGARDEO_GOOGLE_CONNECTION=Google
